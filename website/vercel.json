{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacypolicy", "destination": "/privacypolicy/index.html" },
    { "source": "/delete-account", "destination": "/delete-account/index.html" },
    { "source": "/deleteaccount", "destination": "/delete-account/index.html" },
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/support/", "destination": "/support/index.html" }
  ]
}
