# Iron Miles monorepo — EAS upload exclusions (GIT ROOT)
# EAS only reads .easignore from the repository root. This file replaces all
# .gitignore rules for the upload tarball.

# --- Root .gitignore ---
.idea/
.vscode/
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
next-env.d.ts
*.tsbuildinfo
/build
dist/
dist
*token.json*
*credentials.json*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
.DS_Store
*.pem
__pycache__/
*pyc*
venv/
.venv/
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac
.vercel
agenthub/
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib
.cache/
memory/test_credentials.md
android-sdk/
.env
.env.*
*.env
credentials.json
*.key
.credentials

# --- frontend/.gitignore (paths from repo root) ---
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts
frontend/.kotlin/
frontend/*.orig.*
frontend/.metro-health-check*
frontend/app-example

# --- Development artifacts not needed for Android EAS build ---
frontend/.metro-cache/
frontend/.cache/
frontend/coverage/
*.log
pnpm-debug.log*
Thumbs.db

# Generated native projects (EAS prebuild creates these)
frontend/android/
frontend/ios/

# Keystores / credentials (use EAS credentials; not needed in upload)
*.jks
*.p8
*.p12
*.mobileprovision
frontend/google-service-account.json

# Documentation and non-runtime reference files
README.md
PRODUCTION_READINESS_AUDIT.txt
test_result.md
design_guidelines.json
frontend/README.md

# Monorepo siblings not required for Iron Miles Android build
iron-miles-app/
backend/
supabase/
test_reports/
tests/
memory/
scripts/
.cursor/
.emergent/

# Root package manifest (Expo app uses frontend/package.json)
package.json

# Git metadata (local/non-VCS uploads only)
.git/

# --- Force-include files required for build but potentially gitignored ---
!frontend/google-services.json
